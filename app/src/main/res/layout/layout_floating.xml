<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ══ DRAGGABLE ICON ══ -->
    <TextView
        android:id="@+id/tvIcon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:text="&#127919;"
        android:textSize="26sp"
        android:gravity="center"
        android:background="@drawable/icon_bg"
        android:elevation="12dp"/>

    <!-- ══ PANEL (opens below icon) ══ -->
    <LinearLayout
        android:id="@+id/panelContainer"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="14dp"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:elevation="12dp">

        <!-- Panel Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#9889; FF PANEL"
            android:textColor="#FF4444"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="10dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="10dp"/>

        <!-- Status Text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HEADSHOT: OFF"
            android:textColor="#FF4444"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="10dp"/>

        <!-- Headshot Toggle Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Headshot"
                android:textColor="#CCCCCC"
                android:textSize="12sp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchHeadshot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#FF4444"
                android:trackTint="#333333"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="10dp"/>

        <!-- Close Button -->
        <TextView
            android:id="@+id/tvClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#10005;  CLOSE PANEL"
            android:textColor="#666666"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="4dp"/>

    </LinearLayout>

</LinearLayout>
